{
  // markdownlint configuration for the repository documentation.
  // Rules: https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
  "config": {
    "default": true,
    // Prose is not hard-wrapped; line length is handled by the editor, not enforced here.
    "MD013": false,
    // A translation starts with a `<!-- source: ... -->` marker, so the first line is a comment.
    "MD041": false,
    // Repeated headings are allowed when they are not siblings.
    "MD024": { "siblings_only": true },
    // Tables are used heavily; keep them readable rather than enforcing a pipe style.
    "MD055": false,
    // The delimiter row `|---|---|` is the established style in this repository (README, CHANGELOG).
    "MD060": false
  }
}
